# Copy this file to .env and fill in your Supabase project values.
# Find them in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key both work here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# Server-only secret key (sb_secret_... or legacy service_role). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here
# Optional. Secret a delivery-platform adapter sends as `x-channel-token` to POST /api/orders.
# While unset, orders from any source other than web / pos / kiosk are refused.
# CHANNEL_ORDER_TOKEN=

# Optional global payment gateway fallbacks (each outlet can also configure its own keys in Admin -> Settings):
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# MERCHANT_UPI_VPA=restaurant@okicici
