# Copy this file to .env and fill in your Supabase project values.
# Find them in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key both work here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# Server-only secret key (sb_secret_... or legacy service_role). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here
