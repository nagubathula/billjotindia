# Canonical public app URL (used in auth callback & verification emails; set to https://app.billjot.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional root domain for custom restaurant subdomains (e.g. billjot.com -> <slug>.billjot.com)
# NEXT_PUBLIC_ROOT_DOMAIN=billjot.com
# Optional fallback comma-separated browser origins when calling public endpoints without a per-key website allowlist
# STOREFRONT_ALLOWED_ORIGINS=https://menu.example.com

# Copy this file to .env and fill in your Supabase project values.
# Find them in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key both work here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# Server-only secret key (sb_secret_... or legacy service_role). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here
# Optional. Secret a delivery-platform adapter sends as `x-channel-token` to POST /api/orders.
# While unset, orders from any source other than web / pos / kiosk are refused.
# CHANNEL_ORDER_TOKEN=

# Optional global payment gateway fallbacks (each outlet can also configure its own keys in Admin -> Settings):
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# MERCHANT_UPI_VPA=restaurant@okicici

# Optional 5xx error monitoring alerts (Slack/Discord/custom webhook or Sentry DSN):
# ERROR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# SENTRY_DSN=https://<publicKey>@o0.ingest.sentry.io/<projectId>
